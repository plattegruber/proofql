# Root process env for repo tooling. Copy to `.env` (done for you by
# `pnpm run setup`); `.env` is gitignored and never committed.
#
# Nothing here reaches a worker at runtime — worker vars live in each
# workspace's `.dev.vars`, and wrangler's own Hyperdrive connection string in
# each workspace's `.env` (see workers/*/.env.example).

# The docker compose Postgres (docker-compose.yml; local-only credentials).
# Used by `pnpm db:migrate` and `pnpm test:integration`; both fail loudly when
# it is unset or unreachable rather than silently skipping.
DATABASE_URL=postgres://proofql:proofql@localhost:54323/proofql
