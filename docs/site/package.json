{
  "name": "@proofql/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The developer docs site (docs.proofql.dev): Astro Starlight, deployed as a Worker with static assets.",
  "scripts": {
    "dev": "astro dev --port 4321",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro build --force && node scripts/check-links.mjs && node scripts/check-limits.mjs",
    "test": "pnpm check",
    "lint": "biome check .",
    "typecheck": "astro sync && tsc --noEmit",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.6",
    "@proofql/core": "workspace:*",
    "astro": "^7.4.0",
    "starlight-openapi": "^0.27.0"
  },
  "devDependencies": {
    "@proofql/tsconfig": "workspace:*",
    "@types/node": "^26.6.5",
    "typescript": "^5.9.2",
    "wrangler": "^4.151.1",
    "yaml": "2.9.1"
  }
}
