// Wrangler configuration for the ProofQL dashboard (`proofql-dashboard-<env>`).
//
// !! Bindings are NOT inherited across envs — edit all three sections !!
// Wrangler environments only inherit a small set of top-level keys (main,
// compatibility_date, etc.). Every KV/Hyperdrive binding and every var below
// must be repeated in full inside `env.preview` and `env.prod`. If you add,
// rename, or remove one, update the top-level (local) block AND both env
// blocks.
//
// React Router v7 wiring (#36): `@cloudflare/vite-plugin` consumes this file.
// `react-router build` resolves it (honoring $CLOUDFLARE_ENV for env
// selection), writes the deployable config — including the `assets` block
// for the client build — to build/server/wrangler.json, and drops a redirect
// in .wrangler/deploy/config.json so a plain `wrangler deploy` (or
// `--dry-run`) uses the built artifact. Always build before deploying, and
// select the environment at BUILD time (`CLOUDFLARE_ENV=preview`); the
// `--env preview` flag on `wrangler deploy` must then name the same
// environment (it is accepted, but the bindings come from the build).
// `pnpm run deploy` chains the two for the local config; the deploy
// workflow sets CLOUDFLARE_ENV per job.
//
// Environment matrix, ports, and binding names: see infra/environments.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "proofql-dashboard-local",
  // React Router server entry: exports the fetch handler that delegates to
  // the framework request handler (virtual:react-router/server-build).
  "main": "./workers/app.ts",
  "compatibility_date": "2026-09-01",
  // nodejs_compat: Clerk's SDK (@clerk/backend) needs it.
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  // Fixed ports so `pnpm dev` can run every worker side by side. The
  // dashboard dev server is Vite, so the port is ALSO pinned in
  // vite.config.ts (`server.port: 8799`) — this block only covers a raw
  // `wrangler dev`. Keep the two in sync.
  "dev": {
    "port": 8799,
    "inspector_port": 9241
  },

  "vars": {
    "ENVIRONMENT": "local",
    // Browser-visible origin of the api worker (the playground calls it from
    // the browser).
    "API_URL": "http://localhost:8797",
    // Where the onboarding's snippet tag and preview load the snippet from
    // (#53): the local cdn worker (workers/cdn, port 8800) here, the hosted
    // cdn in deployed environments.
    "SNIPPET_SRC": "http://localhost:8800/v1.js",
    // Google connector (#45; docs/google.md): CREDENTIALS_KEY,
    // GOOGLE_OAUTH_STATE_SECRET, GOOGLE_CLIENT_ID/SECRET, the fake-server
    // endpoint overrides and GOOGLE_CONNECTOR_ENABLED come from `.dev.vars`
    // locally. Deployed: GOOGLE_CLIENT_ID and GOOGLE_CONNECTOR_ENABLED are
    // vars below, the secrets are `wrangler secret put`.
    // Public signup switch (app/lib/signup-gate.ts, docs/launch.md "Go"):
    // open locally and in preview via these vars; in prod it is NOT a var
    // but a `wrangler secret put SIGNUP_OPEN --env prod` value, so the
    // launch flips without a deploy. Unset ⇒ open only when ENVIRONMENT is
    // "local". Set SIGNUP_OPEN=false in .dev.vars to see the waitlist page.
    "SIGNUP_OPEN": "true",
    // Shown in the footer (components/shell/site-footer.tsx) and as the
    // reply-to everywhere; placeholder until the mailbox exists
    // (docs/launch.md "Support"). Empty ⇒ DEFAULT_SUPPORT_EMAIL from core.
    "SUPPORT_EMAIL": "support@proofql.com"
    // Clerk (docs/secrets.md): locally CLERK_PUBLISHABLE_KEY, CLERK_SECRET_KEY
    // and CLERK_WEBHOOK_SIGNING_SECRET come from the gitignored `.dev.vars`
    // (copy `.dev.vars.example`). Leave CLERK_SECRET_KEY empty and the app
    // runs with the local auth stub against the seeded demo account
    // (app/lib/account.server.ts).
  },

  "kv_namespaces": [
    // Same namespace as workers/api: the dashboard purges a project's cached
    // query results when its publication policy changes.
    // <TBD>: real namespace id — provisioned with the Cloudflare account (M0).
    { "binding": "CACHE", "id": "TBD-provision-in-m0" }
  ],

  "r2_buckets": [
    // Uploaded CSV/JSON review exports (#38), keyed
    // `uploads/<projectId>/<ingestRunId>.<ext>`, plus the import's mapping
    // and error report beside them. Buckets are referenced by name (no id to
    // provision); locally Miniflare simulates the bucket.
    { "binding": "UPLOADS", "bucket_name": "proofql-uploads" }
  ],

  "queues": {
    "producers": [
      // The CSV import enqueues one message per imported review, exactly as
      // POST /v1/reviews does; workers/pipeline consumes.
      { "binding": "INGEST_QUEUE", "queue": "proofql-ingest" }
    ]
  },

  "hyperdrive": [
    // See workers/api/wrangler.jsonc for how local dev resolves this.
    // <TBD>: real Hyperdrive config id — provisioned with the Neon project (M0).
    {
      "binding": "HYPERDRIVE",
      "id": "TBD-provision-in-m0",
      "localConnectionString": "postgres://proofql:proofql@localhost:54323/proofql"
    }
  ],

  "env": {
    "preview": {
      "name": "proofql-dashboard-preview",
      "vars": {
        "ENVIRONMENT": "preview",
        // <TBD>: the proofql-api-preview public origin.
        "API_URL": "TBD-provision-in-m0",
        "SNIPPET_SRC": "https://cdn.proofql.com/v1.js",
        // <TBD>: the Google OAuth client id (public; docs/secrets.md,
        // infra/provisioning.md "Google OAuth client"). Not flagged by
        // check-provisioning.mjs on purpose: the connector stays dark —
        // "pending approval" in the UI — until GOOGLE_CONNECTOR_ENABLED is
        // flipped to "true" after Google approves API access (#44).
        "GOOGLE_CLIENT_ID": "TBD-provision-in-m3",
        "GOOGLE_CONNECTOR_ENABLED": "false",
        // Preview is always open: it runs the Clerk development instance and
        // is where the onboarding walkthrough happens (docs/launch.md).
        "SIGNUP_OPEN": "true",
        "SUPPORT_EMAIL": "support@proofql.com",
        // <TBD>: the Clerk *development* instance's publishable key (public,
        // `pk_test_…`; docs/secrets.md). The matching CLERK_SECRET_KEY and
        // CLERK_WEBHOOK_SIGNING_SECRET are wrangler secrets, never vars.
        "CLERK_PUBLISHABLE_KEY": "TBD-provision-in-m0"
      },
      "kv_namespaces": [
        // <TBD>: id of KV namespace `proofql-cache-preview`.
        { "binding": "CACHE", "id": "TBD-provision-in-m0" }
      ],
      "r2_buckets": [
        { "binding": "UPLOADS", "bucket_name": "proofql-uploads-preview" }
      ],
      "queues": {
        "producers": [
          { "binding": "INGEST_QUEUE", "queue": "proofql-ingest-preview" }
        ]
      },
      "hyperdrive": [
        // <TBD>: id of Hyperdrive config `proofql-hyperdrive-preview`.
        { "binding": "HYPERDRIVE", "id": "TBD-provision-in-m0" }
      ],
      // Workers AI for the playground's query embedding (#40) — same rule as
      // workers/api: absent locally (no simulator; the deterministic fake
      // stands in), bound in preview/prod.
      "ai": { "binding": "AI" }
    },
    "prod": {
      "name": "proofql-dashboard-prod",
      // TODO(app.proofql.com): once the zone is on this account, add
      // "routes": [{ "pattern": "app.proofql.com", "custom_domain": true }]
      // and move the Clerk production instance's allowed origins and
      // webhook URL to it (docs/launch.md "Domains", "Clerk production
      // instance"). Until then the worker answers on
      // https://proofql-dashboard-prod.<subdomain>.workers.dev only.
      "vars": {
        "ENVIRONMENT": "prod",
        // <TBD>: the proofql-api-prod public origin.
        "API_URL": "TBD-provision-in-m0",
        "SNIPPET_SRC": "https://cdn.proofql.com/v1.js",
        // <TBD>: the Google OAuth client id (public; docs/secrets.md,
        // infra/provisioning.md "Google OAuth client"). Not flagged by
        // check-provisioning.mjs on purpose: the connector stays dark —
        // "pending approval" in the UI — until GOOGLE_CONNECTOR_ENABLED is
        // flipped to "true" after Google approves API access (#44).
        "GOOGLE_CLIENT_ID": "TBD-provision-in-m3",
        "GOOGLE_CONNECTOR_ENABLED": "false",
        // SIGNUP_OPEN is deliberately absent here (fails closed): the launch
        // switch is `echo true | wrangler secret put SIGNUP_OPEN --env prod`
        // from this directory, flipped back with `false` (docs/launch.md
        // "Go"). A var would need a PR and a deploy to flip.
        "SUPPORT_EMAIL": "support@proofql.com",
        // <TBD>: the Clerk *production* instance's publishable key
        // (`pk_live_…`).
        "CLERK_PUBLISHABLE_KEY": "TBD-provision-in-m0"
      },
      "kv_namespaces": [
        // <TBD>: id of KV namespace `proofql-cache-prod`.
        { "binding": "CACHE", "id": "TBD-provision-in-m0" }
      ],
      "r2_buckets": [
        { "binding": "UPLOADS", "bucket_name": "proofql-uploads-prod" }
      ],
      "queues": {
        "producers": [
          { "binding": "INGEST_QUEUE", "queue": "proofql-ingest-prod" }
        ]
      },
      "hyperdrive": [
        // <TBD>: id of Hyperdrive config `proofql-hyperdrive-prod`.
        { "binding": "HYPERDRIVE", "id": "TBD-provision-in-m0" }
      ],
      "ai": { "binding": "AI" }
    }
  }
}
