---
import {
  DOCS_URL,
  PRIVACY_URL,
  SUBPROCESSORS_URL,
  SUPPORT_EMAIL,
  TERMS_URL,
} from "../config";
import Logo from "./Logo.astro";
---

<footer class="site-footer">
  <div class="container footer-inner">
    <Logo size="sm" />
    <nav aria-label="Footer">
      <ul role="list">
        <li><a href={DOCS_URL}>Docs</a></li>
        <li><a href={PRIVACY_URL}>Privacy</a></li>
        <li><a href={TERMS_URL}>Terms</a></li>
        <li><a href={SUBPROCESSORS_URL}>Subprocessors</a></li>
        <li><a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a></li>
      </ul>
    </nav>
    <p class="copyright">© ProofQL</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--hairline);
  }
  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
    padding-block: 2rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--fg-secondary);
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  a {
    display: inline-block;
    padding-block: 0.375rem;
    color: inherit;
    text-decoration: none;
  }
  a:hover {
    color: var(--fg);
    text-decoration: underline;
  }
  .copyright {
    margin-inline-start: auto;
  }
</style>
