---
// The ProofQL logo: the mark (Creature.astro) and the wordmark. Every use on
// the site goes through this component. The nav's mark blinks now and then
// (`blink`); there is no cursor tracking at this size. The visible
// "ProofQL" text is the logo's name; the mark is decorative.
import Creature from "./Creature.astro";

interface Props {
  /** Visual size; the footer uses the smaller one. */
  size?: "md" | "sm";
  blink?: boolean;
}

const { size = "md", blink = false } = Astro.props;
---

<span class:list={["logo", `logo-${size}`]}>
  <Creature motion={blink ? "blink" : "none"} class="logo-mark" />
  <span class="logo-word">ProofQL</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    font-family: var(--font-sans);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--fg);
  }
  .logo-md {
    font-size: 1.375rem;
  }
  .logo-sm {
    font-size: 1.125rem;
  }
  /* The braces' ink is about 0.94em of the mark's 1em box, so at 1.1em the
     mark stands a touch taller than the capitals. */
  .logo :global(.logo-mark) {
    font-size: 1.1em;
    letter-spacing: 0;
  }
</style>
