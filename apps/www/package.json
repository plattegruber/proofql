{
  "name": "@proofql/www",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The marketing site (proofql.dev): Astro, static output, deployed as a Worker with static assets.",
  "scripts": {
    "dev": "astro dev --port 4322",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro build && node scripts/check-site.mjs",
    "test": "pnpm check && vitest run",
    "lint": "biome check .",
    "typecheck": "astro sync && tsc --noEmit",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@proofql/core": "workspace:*",
    "@proofql/snippet": "workspace:*",
    "@proofql/tsconfig": "workspace:*",
    "@types/node": "^26.6.3",
    "astro": "^7.3.5",
    "axe-core": "^4.13.0",
    "happy-dom": "^20.14.5",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.145.0"
  }
}
