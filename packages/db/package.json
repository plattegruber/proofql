{
  "name": "@proofql/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./test": {
      "types": "./test/index.ts",
      "import": "./test/index.ts",
      "default": "./test/index.ts"
    },
    "./test/globalSetup": {
      "types": "./test/globalSetup.ts",
      "import": "./test/globalSetup.ts",
      "default": "./test/globalSetup.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit -p tsconfig.check.json"
  },
  "devDependencies": {
    "@proofql/ai": "workspace:*",
    "@proofql/tsconfig": "workspace:*",
    "@types/node": "^26.6.3",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "postgres": "^3.4.9"
  }
}
