{
  "name": "@proofql/cdn",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "cdn.proofql.dev: serves the built snippet (/v1.js, /v1.<hash>.js) and the hosted demo site (/demo/).",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && wrangler dev",
    "deploy": "node scripts/build.mjs && wrangler deploy",
    "test": "vitest run",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260711.1",
    "@proofql/snippet": "workspace:*",
    "@proofql/tsconfig": "workspace:*",
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.145.0"
  }
}
