// Wrangler configuration for the ProofQL cdn worker (`proofql-cdn-<env>`).
//
// What it serves (scope.md §3 "Snippet", #34, #35):
//
//   /v1.js             the latest snippet build — what the script tag loads;
//                      5 minute cache, a day of stale-while-revalidate
//   /v1.<hash>.js      the same bytes under a content hash — immutable, a year
//   /v1.js.map, /v1.<hash>.js.map
//   /version.json      { version, hash, builtAt } of the deployed build
//   /health            { ok: true, version, hash } for the deploy smoke check
//   /demo/             the hosted demo: a static small-business site using the
//                      snippet against the seeded demo project
//
// Every file comes from the `public/` directory and is served by Workers
// static assets **without invoking the worker** (#158): asset requests are
// free and unmetered, while a worker invocation counts against the Workers
// Free plan's 100,000 requests a day — and a snippet load is one per page
// view of every customer site. The cache, CORS, CORP and nosniff headers
// come from public/_headers, which scripts/build.mjs writes with the same
// values src/handler.ts uses (src/build.test.ts checks they agree).
// `run_worker_first` is limited to `/health`; the worker also answers
// whatever no asset matches (404s, `/` → `/demo/`, OPTIONS). public/ is
// built by `pnpm --filter @proofql/cdn build` (scripts/build.mjs) and
// gitignored except for public/demo/; always build before deploying — the
// deploy workflow does.
//
// No KV, no Hyperdrive, no queue, nothing to provision: this worker holds no
// state and reads no database. `scripts/check-provisioning.mjs` lists it
// only so the deploy order and env blocks are checked.
//
// !! `assets` is repeated in each env block on purpose: wrangler environments
// do not inherit bindings, and the binding is what the worker reads.
//
// Environment matrix, ports, and binding names: see infra/environments.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",

  // Top-level config is the LOCAL default (`wrangler dev`). Local runs never
  // deploy; the name still follows `proofql-<name>-<env>`.
  "name": "proofql-cdn-local",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  // Fixed ports so `pnpm dev` can run every worker side by side
  // (api 8797, pipeline 8798, dashboard 8799, cdn 8800).
  "dev": {
    "port": 8800,
    "inspector_port": 9242
  },

  "vars": {
    "ENVIRONMENT": "local"
  },

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Only /health needs code; everything else is a static asset whose
    // headers come from public/_headers (header comment, #158).
    "run_worker_first": ["/health"],
    // `/demo` → `/demo/` → demo/index.html.
    "html_handling": "auto-trailing-slash",
    // A path that is not an asset is a plain 404 (no SPA fallback).
    "not_found_handling": "none"
  },

  "env": {
    "preview": {
      "name": "proofql-cdn-preview",
      "vars": { "ENVIRONMENT": "preview" },
      "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        "run_worker_first": ["/health"],
        "html_handling": "auto-trailing-slash",
        "not_found_handling": "none"
      }
    },
    "prod": {
      "name": "proofql-cdn-prod",
      // Workers Custom Domain on the proofql.dev zone (infra/provisioning.md
      // "Custom domains"); the snippet tag and the dashboard's SNIPPET_SRC
      // point here.
      "routes": [{ "pattern": "cdn.proofql.dev", "custom_domain": true }],
      // Custom domain only; workers.dev off (see workers/api/wrangler.jsonc).
      "workers_dev": false,
      "vars": { "ENVIRONMENT": "prod" },
      "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        "run_worker_first": ["/health"],
        "html_handling": "auto-trailing-slash",
        "not_found_handling": "none"
      }
    }
  }
}
