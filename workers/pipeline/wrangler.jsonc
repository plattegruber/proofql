// Wrangler configuration for the ProofQL pipeline worker (`proofql-pipeline-<env>`).
//
// !! Bindings are NOT inherited across envs — edit all three sections !!
// Wrangler environments only inherit a small set of top-level keys (main,
// compatibility_date, etc.). Every queue/KV/Hyperdrive/AI binding below must
// be repeated in full inside `env.preview` and `env.prod`. If you add, rename,
// or remove a binding, update the top-level (local) block AND both env blocks.
//
// One queue: workers/api produces to `proofql-ingest`, this worker consumes
// (deterministic chunking, bge-m3 embeddings, sentiment for unrated sources,
// KV cache purge). Batch tuning: volumes are small, correctness beats
// throughput — max_batch_size 10 / max_batch_timeout 5s. Retries back off
// exponentially (handler-supplied delay; `retry_delay` is the floor) and
// messages that fail three times land in `proofql-ingest-dlq`, which nothing
// consumes yet — #72's sweep re-enqueues stuck reviews from the database.
//
// Environment matrix, ports, and binding names: see infra/environments.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "proofql-pipeline-local",
  // Worker entrypoint. Kept separate from src/index.ts: workerd only allows
  // handler exports on the entry module, and unit tests import
  // src/handlers.ts under Node.
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  // Fixed ports so `pnpm dev` can run every worker side by side.
  "dev": {
    "port": 8798,
    "inspector_port": 9240
  },

  "vars": {
    "ENVIRONMENT": "local"
  },

  "queues": {
    "consumers": [
      {
        "queue": "proofql-ingest",
        "max_retries": 3,
        // Floor for a retry that carries no explicit delay (an uncaught
        // exception); the handler itself retries with exponential backoff
        // (30s/60s/120s, src/handlers.ts). Three attempts, then the DLQ.
        "retry_delay": 30,
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "dead_letter_queue": "proofql-ingest-dlq"
      }
    ]
  },

  "kv_namespaces": [
    // Same namespace as workers/api: the pipeline purges a project's cached
    // query results after indexing new reviews.
    // <TBD>: real namespace id — provisioned with the Cloudflare account (M0).
    { "binding": "CACHE", "id": "TBD-provision-in-m0" }
  ],

  "hyperdrive": [
    // See workers/api/wrangler.jsonc for how local dev resolves this.
    // <TBD>: real Hyperdrive config id — provisioned with the Neon project (M0).
    {
      "binding": "HYPERDRIVE",
      "id": "TBD-provision-in-m0",
      "localConnectionString": "postgres://proofql:proofql@localhost:54323/proofql"
    }
  ],

  // Workers AI (`AI`: bge-m3 embeddings, distilbert sentiment) is absent from
  // the local block for the reason given in workers/api/wrangler.jsonc; code
  // falls back to the deterministic fake provider locally.

  "env": {
    "preview": {
      "name": "proofql-pipeline-preview",
      "vars": { "ENVIRONMENT": "preview" },
      "queues": {
        "consumers": [
          {
            "queue": "proofql-ingest-preview",
            "max_retries": 3,
            "retry_delay": 30,
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "dead_letter_queue": "proofql-ingest-dlq-preview"
          }
        ]
      },
      "kv_namespaces": [
        // <TBD>: id of KV namespace `proofql-cache-preview`.
        { "binding": "CACHE", "id": "TBD-provision-in-m0" }
      ],
      "hyperdrive": [
        // <TBD>: id of Hyperdrive config `proofql-hyperdrive-preview`.
        { "binding": "HYPERDRIVE", "id": "TBD-provision-in-m0" }
      ],
      "ai": { "binding": "AI" }
    },
    "prod": {
      "name": "proofql-pipeline-prod",
      "vars": { "ENVIRONMENT": "prod" },
      "queues": {
        "consumers": [
          {
            "queue": "proofql-ingest-prod",
            "max_retries": 3,
            "retry_delay": 30,
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "dead_letter_queue": "proofql-ingest-dlq-prod"
          }
        ]
      },
      "kv_namespaces": [
        // <TBD>: id of KV namespace `proofql-cache-prod`.
        { "binding": "CACHE", "id": "TBD-provision-in-m0" }
      ],
      "hyperdrive": [
        // <TBD>: id of Hyperdrive config `proofql-hyperdrive-prod`.
        { "binding": "HYPERDRIVE", "id": "TBD-provision-in-m0" }
      ],
      "ai": { "binding": "AI" }
    }
  }
}
