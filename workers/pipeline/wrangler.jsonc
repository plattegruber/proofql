// Wrangler configuration for the ProofQL pipeline worker (`proofql-pipeline-<env>`).
//
// !! Bindings are NOT inherited across envs — edit all three sections !!
// Wrangler environments only inherit a small set of top-level keys (main,
// compatibility_date, etc.). Every queue/KV/Hyperdrive/AI binding below must
// be repeated in full inside `env.preview` and `env.prod`. If you add, rename,
// or remove a binding, update the top-level (local) block AND both env blocks.
//
// Two queues, one worker: workers/api produces to `proofql-ingest`, this
// worker consumes (deterministic chunking, bge-m3 embeddings, sentiment for
// unrated sources, KV cache purge). Batch tuning: volumes are small,
// correctness beats throughput — max_batch_size 10 / max_batch_timeout 5s.
// Retries back off exponentially (handler-supplied delay; `retry_delay` is
// the floor) and messages that fail three times land in `proofql-ingest-dlq`,
// which this same worker also consumes (#82, src/dlq.ts): one `ingest_runs`
// failed row per dead letter, so the dashboard can show a stuck review with
// a reason. That consumer never retries (`max_retries: 0`) and has no DLQ of
// its own — a dead letter that cannot be recorded is logged and acked.
// Recovery is #72's sweep, which re-enqueues stuck reviews from the database.
// `src/handlers.ts` routes on `batch.queue` (the `dlq` name segment).
//
// Environment matrix, ports, and binding names: see infra/environments.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "proofql-pipeline-local",
  // Worker entrypoint. Kept separate from src/index.ts: workerd only allows
  // handler exports on the entry module, and unit tests import
  // src/handlers.ts under Node.
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  // Fixed ports so `pnpm dev` can run every worker side by side.
  "dev": {
    "port": 8798,
    "inspector_port": 9240
  },

  "vars": {
    "ENVIRONMENT": "local"
    // Google connector (#46): CREDENTIALS_KEY, GOOGLE_CLIENT_ID,
    // GOOGLE_CLIENT_SECRET and the fake-server endpoint overrides come from
    // the gitignored `.dev.vars` (copy `.dev.vars.example`; `pnpm run setup`
    // generates the key). Deployed: GOOGLE_CLIENT_ID is a var below, the two
    // secrets are `wrangler secret put`.
    //
    // Places refresh (#116): GOOGLE_PLACES_API_KEY (secret, the same key the
    // dashboard holds; `wrangler secret put` per env, docs/secrets.md) and
    // the optional PLACES_API_BASE override (local only: the fake Places API
    // on :8803) also come from `.dev.vars`. Unset ⇒ the daily cron logs
    // `places.refresh.skipped` and does nothing.
  },

  // One cron per environment (#174): the Workers Free plan allows five cron
  // triggers per account. Every five-minute tick, src/schedule.ts picks the
  // jobs due at `controller.scheduledTime` (UTC, rounded down to 5 minutes);
  // each runs isolated, so one failing does not skip the rest:
  // - every tick: re-enqueue sweep (#72, src/sweep.ts): reviews stuck with
  //   indexed_at IS NULL for 5+ minutes go back on the queue (500/tick, five
  //   attempts per review).
  // - 00/06/12/18:00: Google review polling (#46, src/google-poll.ts): every
  //   active Google connection, paced under the shared 300 QPM quota. Does
  //   nothing until CREDENTIALS_KEY / GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET
  //   are set (docs/secrets.md).
  // - 03:30: Places bootstrap refresh (#116, src/places-refresh.ts):
  //   re-fetch every Places-bootstrapped place whose latest `places` run is
  //   25+ days old, for projects without an active Google connection
  //   (200/tick, oldest first). Does nothing until GOOGLE_PLACES_API_KEY is
  //   set (docs/places.md).
  // - 04:15: account purge (#169, src/account-purge.ts): workspaces
  //   soft-deleted 30+ days ago are hard-deleted (FK cascades) and their
  //   projects' `uploads/<id>/` R2 prefixes removed, 50 accounts per tick.
  // A skipped tick skips that run; every job is idempotent and age-based, so
  // its next due tick catches up. Locally: `wrangler dev --test-scheduled`,
  // then GET /cdn-cgi/local/scheduled?time=<epoch ms of a due time>.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },

  "queues": {
    // The sweep produces to the same queue this worker consumes.
    "producers": [{ "binding": "INGEST_QUEUE", "queue": "proofql-ingest" }],
    "consumers": [
      {
        "queue": "proofql-ingest",
        "max_retries": 3,
        // Floor for a retry that carries no explicit delay (an uncaught
        // exception); the handler itself retries with exponential backoff
        // (30s/60s/120s, src/handlers.ts). Three attempts, then the DLQ.
        "retry_delay": 30,
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "dead_letter_queue": "proofql-ingest-dlq"
      },
      {
        // Dead letters: record, never retry, no further DLQ (#82).
        // Larger, slower batches — one row insert per message, no AI calls.
        "queue": "proofql-ingest-dlq",
        "max_retries": 0,
        "max_batch_size": 25,
        "max_batch_timeout": 30
      }
    ]
  },

  "kv_namespaces": [
    // Same namespace as workers/api: the pipeline purges a project's cached
    // query results after indexing new reviews.
    // <TBD>: real namespace id — provisioned with the Cloudflare account (M0).
    { "binding": "CACHE", "id": "TBD-provision-in-m0" }
  ],

  "hyperdrive": [
    // See workers/api/wrangler.jsonc for how local dev resolves this.
    // <TBD>: real Hyperdrive config id — provisioned with the Neon project (M0).
    {
      "binding": "HYPERDRIVE",
      "id": "TBD-provision-in-m0",
      "localConnectionString": "postgres://proofql:proofql@localhost:54323/proofql"
    }
  ],

  // The dashboard's uploads bucket (#169), bound only so the account purge
  // can delete a purged workspace's `uploads/<projectId>/` prefixes. Same
  // bucket names as apps/dashboard/wrangler.jsonc; locally Miniflare
  // simulates it per worker, so the local purge sees an empty bucket.
  "r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "proofql-uploads" }],

  // Workers AI (`AI`: bge-m3 embeddings, distilbert sentiment) is absent from
  // the local block for the reason given in workers/api/wrangler.jsonc; code
  // falls back to the deterministic fake provider locally.

  "env": {
    "preview": {
      "name": "proofql-pipeline-preview",
      "vars": {
        "ENVIRONMENT": "preview",
        // <TBD>: the Google OAuth client id (public; docs/secrets.md). The
        // connector stays dark — `google.poll.skipped` — until this and the
        // two secrets are set, which waits on Google API access (#44).
        "GOOGLE_CLIENT_ID": "TBD-provision-in-m3"
      },
      "triggers": {
        "crons": ["*/5 * * * *"]
      },
      "queues": {
        "producers": [
          { "binding": "INGEST_QUEUE", "queue": "proofql-ingest-preview" }
        ],
        "consumers": [
          {
            "queue": "proofql-ingest-preview",
            "max_retries": 3,
            "retry_delay": 30,
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "dead_letter_queue": "proofql-ingest-dlq-preview"
          },
          {
            "queue": "proofql-ingest-dlq-preview",
            "max_retries": 0,
            "max_batch_size": 25,
            "max_batch_timeout": 30
          }
        ]
      },
      "kv_namespaces": [
        // KV namespace proofql-cache-preview (created 2026-10-04).
        { "binding": "CACHE", "id": "8cc94fb4ff7941bb909b5f0628b02d2f" }
      ],
      "hyperdrive": [
        // <TBD>: id of Hyperdrive config `proofql-hyperdrive-preview`.
        { "binding": "HYPERDRIVE", "id": "ec18323ec9474ad9a0c404aa1911bfd7" }
      ],
      "r2_buckets": [
        { "binding": "UPLOADS", "bucket_name": "proofql-uploads-preview" }
      ],
      "ai": { "binding": "AI" }
    },
    "prod": {
      "name": "proofql-pipeline-prod",
      "vars": {
        "ENVIRONMENT": "prod",
        // <TBD>: the Google OAuth client id (public; docs/secrets.md). The
        // connector stays dark — `google.poll.skipped` — until this and the
        // two secrets are set, which waits on Google API access (#44).
        "GOOGLE_CLIENT_ID": "TBD-provision-in-m3"
      },
      "triggers": {
        "crons": ["*/5 * * * *"]
      },
      "queues": {
        "producers": [
          { "binding": "INGEST_QUEUE", "queue": "proofql-ingest-prod" }
        ],
        "consumers": [
          {
            "queue": "proofql-ingest-prod",
            "max_retries": 3,
            "retry_delay": 30,
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "dead_letter_queue": "proofql-ingest-dlq-prod"
          },
          {
            "queue": "proofql-ingest-dlq-prod",
            "max_retries": 0,
            "max_batch_size": 25,
            "max_batch_timeout": 30
          }
        ]
      },
      "kv_namespaces": [
        // KV namespace proofql-cache-prod (created 2026-10-04).
        { "binding": "CACHE", "id": "7623c7022e46429fac1819062deaba11" }
      ],
      "hyperdrive": [
        // <TBD>: id of Hyperdrive config `proofql-hyperdrive-prod`.
        { "binding": "HYPERDRIVE", "id": "796092f0ab1444bb8df0a60fdf8b7824" }
      ],
      "r2_buckets": [
        { "binding": "UPLOADS", "bucket_name": "proofql-uploads-prod" }
      ],
      "ai": { "binding": "AI" }
    }
  }
}
